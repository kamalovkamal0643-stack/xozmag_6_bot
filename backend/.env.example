# Bu faylni nusxalab, nomini .env ga o'zgartiring va qiymatlarni to'ldiring.

# ===== MA'LUMOTLAR BAZASI =====
# Lokal PostgreSQL: start.bat uni avtomatik yoqadi (port 5433).
# Neon'ga o'tmoqchi bo'lsangiz, DATABASE_URL ga Neon satrini o'zgartirmasdan yozing.
# DIRECT_URL ixtiyoriy: bo'sh bo'lsa, DATABASE_URL ishlatiladi.
DATABASE_URL="postgresql://postgres@localhost:5433/hozmagazin?schema=public&connect_timeout=15"
DIRECT_URL="postgresql://postgres@localhost:5433/hozmagazin?schema=public&connect_timeout=15"

# ===== TELEGRAM BOT =====
# @BotFather bergan token
BOT_TOKEN=""
# Adminlarning Telegram ID raqamlari (vergul bilan). ID ni botga /id yuborib bilasiz
ADMIN_IDS=""
# start.bat Cloudflare tunnel manzilini bu yerga avtomatik yozadi
MINIAPP_URL=""

# ===== ADMIN PANEL (faqat shu kompyuterda: http://localhost:5174) =====
ADMIN_PANEL_URL="http://localhost:5174"
# O'zingiz parol o'ylab toping
ADMIN_PASSWORD=""
# Istalgan uzun tasodifiy matn (kamida 32 belgi)
ADMIN_SECRET=""

# ===== SERVER =====
PORT=5000
# true = Mini App'ni shu kompyuter brauzerida Telegram'siz sinash mumkin (tunnel orqali emas)
SKIP_TELEGRAM_AUTH="true"

# ===== DO'KON SOZLAMALARI =====
SHOP_NAME="Hozmagazin"
SHOP_PHONE="+998 90 123 45 67"
SHOP_WORK_HOURS="09:00 - 21:00"
DELIVERY_FEE=10000
FREE_DELIVERY_FROM=200000
MIN_ORDER=20000

# ===== HISOBOTLAR =====
DAILY_REPORT_CRON="0 20 * * *"
TZ_NAME="Asia/Tashkent"
TZ_OFFSET_MINUTES=300
